# Set these as environment variables before starting the API. .NET does not load this file automatically.
ConnectionStrings__Database=Host=localhost;Port=5433;Database=eduforge;Username=eduforge;Password=your-password
Auth__SigningKey=replace-with-a-random-secret-at-least-32-bytes-long
Frontend__Origin=http://localhost:3000
Database__ApplyMigrations=true
Google__ClientId=
Google__ClientSecret=
AI__ApiKey=
AI__Model=

# Optional image generation and email password recovery
AI__ImageModel=gpt-image-2.5-sunburst
Admin__Email=
Smtp__Host=
Smtp__Port=587
Smtp__From=
Smtp__User=
Smtp__Password=

# Persistent browser sign-in, 1–90 days
Auth__SessionDays=30
